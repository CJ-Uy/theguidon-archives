# Cloudflare D1 (HTTP REST fallback for `pnpm dev` against remote D1)
CLOUDFLARE_ACCOUNT_ID=8527ec1369d46f55304a6f59ab5356e4
CLOUDFLARE_D1_DATABASE_ID=eca88308-ea71-4aa2-afff-501e4b05d0b7
CLOUDFLARE_D1_TOKEN=<API token with D1 read/write>

# Cloudflare R2 — used to mint presigned PUT URLs from the admin upload route.
# Create via Cloudflare dashboard -> R2 -> Manage R2 API Tokens. Permissions:
# Object Read & Write, scoped to bucket "theguidon-archives".
R2_ACCESS_KEY_ID=<from R2 API token>
R2_SECRET_ACCESS_KEY=<from R2 API token>

# Public R2 URL — visible to the public site for reading WebPs/PDFs/covers.
# Get this by enabling public access on the R2 bucket in the dashboard.
# Placeholder until DNS is set on cdn.theguidon.com.
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxxxxxxxxx.r2.dev
